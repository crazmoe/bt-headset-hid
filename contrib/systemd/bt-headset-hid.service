[Unit]
Description=Bluetooth headset buttons as HID telephony device
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
# Use -mode hfp for all buttons without call audio (see README).
ExecStart=/usr/local/bin/bt-headset-hid -mode pipewire
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
